{
  "name": "meyar",
  "productName": "Meyar",
  "version": "0.1.0",
  "private": true,
  "description": "Meyar — Azərbaycan şirkətləri üçün mühasibat və biznes idarəetmə proqramı",
  "author": "Ağarza Ağalarov",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/node/src/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:node && npm run build:web",
    "runtime:install": "install-electron",
    "test": "npm run build:node && node --test \"dist/node/tests/domain/*.test.js\" \"dist/node/tests/integration/*.test.js\"",
    "test:ui": "node --import tsx --test \"tests/ui/*.test.tsx\"",
    "start": "npm run runtime:install && npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "appId": "az.meyar.app",
    "productName": "Meyar",
    "artifactName": "Meyar-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/node/src/**",
      "dist/web/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
